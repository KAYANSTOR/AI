# Database (Railway Postgres). On Railway use ${{Postgres.DATABASE_URL}}.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/frontdesk
# Optional: "require" | "disable" (auto-detected by default).
DATABASE_SSL=
DATABASE_POOL_SIZE=

# Sessions: a long random string (openssl rand -base64 48).
AUTH_SECRET=
# 32-byte key, base64 (openssl rand -base64 32). Must stay identical across deployments
# or previously stored channel credentials cannot be decrypted.
CREDENTIAL_ENCRYPTION_KEY=

# Public URL of the app.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_APP_URL=

# Shared secret for /api/cron/* workers.
CRON_SECRET=

# AI model
GEMINI_API_KEY=
GEMINI_MODEL=

# Meta (WhatsApp / Instagram)
META_APP_SECRET=
META_GRAPH_BASE_URL=
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_EMBEDDED_CONFIG_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_VERIFY_TOKEN=
# "true" lets organizations fall back to the platform-level provider credentials above.
PLATFORM_PROVIDER_CREDENTIALS=

# Voice (Vapi) and SMS (Twilio)
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=
VAPI_PHONE_NUMBER_ID=
VAPI_PHONE_NUMBER=
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
TWILIO_AUTH_TOKEN=

# Billing (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
